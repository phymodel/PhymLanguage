Latex()
.name("textConcept")
.mesh(width: 0.6, textPath: "时间间隔公式#时刻与时间间隔")
.material(red: 1.0, green: 1.0, blue: 1.0, opacity: 0.999, roughness: 0.5, metallic: 0.8)
.physic(mass: 0.1, staticFriction: 0.9, dynamicFriction: 0.75, restitution: 0.22, mode: .kinematic)
.position(x: 0.0, y: 1.8, z: 0.0)

Latex()
.name("textInitial")
.mesh(width: 0.7, text: 
¥¥
<center>
<span style="font-size: 90px;">初时刻 $t_1 = 1 \,{\rm s}$</span>
</center>
¥¥
)
.material(red: 1.0, green: 1.0, blue: 1.0, opacity: 0.999, roughness: 0.5, metallic: 0.8)
.physic(mass: 0.1, staticFriction: 0.9, dynamicFriction: 0.75, restitution: 0.22, mode: .kinematic)
.position(x: -1.0, y: 1.6, z: 0.0)

Latex()
.name("textFinal")
.mesh(width: 0.7, text: 
¥¥
<center>
<span style="font-size: 90px;">末时刻 $t_2 = 11 \,{\rm s}$</span>
</center>
¥¥
)
.material(red: 1.0, green: 1.0, blue: 1.0, opacity: 0.999, roughness: 0.5, metallic: 0.8)
.physic(mass: 0.1, staticFriction: 0.9, dynamicFriction: 0.75, restitution: 0.22, mode: .kinematic)
.position(x: 1.0, y: 1.6, z: 0.0)

Latex()
.name("text12")
.mesh(width: 1.8, text: 
¥¥
<center>
<span style="font-size: 90px;">时间间隔 $\Delta t = t_2 - t_1 = 11 \,{\rm s} - 1 \,{\rm s} = 10 \,{\rm s}$</span>
</center>
¥¥
)
.material(red: 1.0, green: 1.0, blue: 1.0, opacity: 0.999, roughness: 0.5, metallic: 0.8)
.physic(mass: 0.1, staticFriction: 0.9, dynamicFriction: 0.75, restitution: 0.22, mode: .kinematic)
.position(x: 0.0, y: 1.3, z: 0.0)

CAD()
.name("TimeInterval")
.mesh(commands: [
    "DEF cylinder = PATH_FORMULA 0,0,0 X (x-0.0)^2+(y-0.0)^2=0.015^2 EXT 2.0 FILLET 0.01"
])
.material(red: 0.5, green: 0.8, blue: 0.3, opacity: 1, roughness: 0.5, metallic: 0.8)
.physic(mass: 0.5, staticFriction: 0.6, dynamicFriction: 0.4, restitution: 0.2, mode: .kinematic)
.position(x: -1.0, y: 1.5, z: 0.0)
.isEnabled(false)

CAD()
.name("initial")
.mesh(commands: [
    "DEF sphere = SOLID_FORMULA 0,0,0 (x/0.03)^2+(y/0.03)^2+(z/0.03)^2-1=0",
])
.physic(mass: 0.6, staticFriction: 0.6, dynamicFriction: 0.4, restitution: 0.2, mode: .kinematic)
.material(red: 0.47, green: 0.83, blue: 0.3, opacity: 1, roughness: 0.5, metallic: 0.8)
.position(x: -1.0, y: 1.5, z: 0.0)
.isEnabled(false)

CAD()
.name("final")
.mesh(commands: [
    "DEF sphere = SOLID_FORMULA 0,0,0 (x/0.03)^2+(y/0.03)^2+(z/0.03)^2-1=0",
])
.physic(mass: 0.6, staticFriction: 0.6, dynamicFriction: 0.4, restitution: 0.2, mode: .kinematic)
.material(red: 0.47, green: 0.83, blue: 0.3, opacity: 1, roughness: 0.5, metallic: 0.8)
.position(x: 1.0, y: 1.5, z: 0.0)
.isEnabled(false)

// 打组系统（坐标系），Group 不可省略
Group()
.name("CoordinateSystem")
.entity[
    "CoordinateSystemBodyArrow",
    "unitLength",
    "unit",
    "CoordinateSystemEllipsoid[i]",
    "CoordinateSystemText[i]"
]
.position(x: 0.0, y: 1.5, z: 0.0)

// 坐标系主体

CAD()
.name("CoordinateSystemBodyArrow")
.mesh(commands: [
    "DEF arrow = PATH_OPEN 0,0,0 Z 2.9,0 2.8,-0.03 2.8,-0.01 0,-0.01 0,0  REV X 360"
])
.material(red: 0.5, green: 0.5, blue: 0.5, opacity: 1, roughness: 0.3, metallic: 0.9)
.physic(mass: 0.5, staticFriction: 0.6, dynamicFriction: 0.4, restitution: 0.2, mode: .kinematic)
.position(x: -1.4, y: 0.0, z: 0.0)

Text()
.name("unitLength")
.mesh(text: "t", extrusionDepth: 0.001, font: "Times New Roman Italic", fontSize: 0.05)
.material(red: 0.9, green: 0.1, blue: 0.3, opacity: 1, roughness: 0.5, metallic: 0.8)
.physic(mass: 0.3, staticFriction: 0.6, dynamicFriction: 0.4, restitution: 0.2, mode: .kinematic)
.position(x: 1.4, y: -0.08, z: 0.0)

Text()
.name("unit")
.mesh(text: "/s", extrusionDepth: 0.001, font: "Times New Roman", fontSize: 0.05)
.material(red: 0.9, green: 0.1, blue: 0.3, opacity: 1, roughness: 0.5, metallic: 0.8)
.physic(mass: 0.3, staticFriction: 0.6, dynamicFriction: 0.4, restitution: 0.2, mode: .kinematic)
.position(x: 1.43, y: -0.08, z: 0.0)

// 批量生成元素（刻度）
Repeat(13) { i in
    CAD()
    .name("CoordinateSystemEllipsoid[i]")
    .mesh(commands: [
        "DEF sphere = SOLID_FORMULA 0,0,0 (x/0.02)^2+(y/0.02)^2+(z/0.02)^2-1=0",
    ])
    .physic(mass: 0.6, staticFriction: 0.6, dynamicFriction: 0.4, restitution: 0.2, mode: .kinematic)
    .material(red: 0.67, green: 0.32, blue: 1.0, opacity: 1, roughness: 0.5, metallic: 0.8)
    .position(x: -1.2 + i * 0.2, y: 0.0, z: 0.0)
}

Repeat(13) { i in
    Text()
    .name("CoordinateSystemText[i]")
    .mesh(text: "[i]", extrusionDepth: 0.001, font: "Times New Roman", fontSize: 0.05)
    .material(red: 0.9, green: 0.1, blue: 0.3, opacity: 1, roughness: 0.5, metallic: 0.8)
    .physic(mass: 0.3, staticFriction: 0.6, dynamicFriction: 0.4, restitution: 0.2, mode: .kinematic)
    .position(x: -1.2 + i * 0.2, y: -0.08, z: 0.0)
}