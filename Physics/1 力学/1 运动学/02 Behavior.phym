
Behavior()
.name("tapInitial")
.trigger{
    Tap(){
        objects: ["textInitial"]
    }
}
.actions{
    Speak(1){
        object: "textInitial",
        volume: 0.5,
        text: "位置是物体在参考系中所在的空间位置，通常用坐标表示。这是初位置，表示这一过程的起点。"
    }
    Emphasize(1){
        objects: ["textInitial", "initial"],
        motionType: .pulse,
        duration: 1
    }
    Show(1){
        objects: ["initial"]
        motionType: .pop
        duration: 1.5
    }
    Hide(3){
        objects: ["initial"]
        motionType: .scale
        duration: 0.5
    }
}

Behavior()
.name("tapFinal")
.trigger{
    Tap(){
        objects: ["textFinal"]
    }
}
.actions{
    Speak(1){
        object: "textFinal",
        volume: 0.5,
        text: "位置是物体在参考系中所在的空间位置，通常用坐标表示。这是末位置，表示这一过程的终点。"
    }
    Emphasize(1){
        objects: ["textFinal", "final"],
        motionType: .pulse,
        duration: 1
    }
    Show(1){
        objects: ["final"]
        motionType: .pop
        duration: 1.5
    }
    Hide(3){
        objects: ["final"]
        motionType: .scale
        duration: 0.5
    }
}

Behavior()
.name("tapText12")
.trigger{
    Tap(){
        objects: ["text12"]
    }
}
.actions{
    Speak(1){
        object: "text12",
        volume: 0.5,
        text: "位移是位置的变化量，即由初位置指向末位置的有向线段，是矢量。"
    }
    Emphasize(1){
        objects: ["text12", "TimeInterval"],
        motionType: .pulse,
        duration: 1
    }
    Show(1){
        objects: ["TimeInterval"]
        motionType: .pop
        duration: 1.5
    }
    Hide(3){
        objects: ["TimeInterval"]
        motionType: .scale
        duration: 0.5
    }
}

Behavior()
.name("formulaTap")
.trigger{
    Tap(){
        objects: ["textFormula"]
    }
}
.actions{
    Emphasize(1){
        objects: ["textFormula"],
        motionType: .pulse,
        duration: 1
    }
    Speak(1){
        object: "textFormula",
        volume: 0.5,
        text: "时间公式：时间间隔等于末时刻减去初时刻。"
    }
    
}
