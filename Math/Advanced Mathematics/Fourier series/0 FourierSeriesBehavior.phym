Behavior()
.name("goSawtooth")
.trigger{
    Tap(){
        objects: ["Sawtooth"]
    }
}
.actions{
    Emphasize(1){
        objects: ["Sawtooth"],
        motionType: .pop,
        duration: 0.4
    }
    Speak(2){
        object: "Sawtooth",
        text: "锯齿波的傅立叶级数展开。"
    }
    OpenScene(3){
        scene: "2 锯齿波.md",
        duration: 0
    }
}

