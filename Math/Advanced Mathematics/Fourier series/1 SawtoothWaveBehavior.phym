
Behavior()
.name("tap_SawtoothTextRun")
.trigger{
    Tap(){
        objects: ["SawtoothTextRun"]
    }
}
.actions{

    Hide(0){
        objects: ["SawtoothTextRun"]
        motionType: .scale
        duration: 0.5
    }
    // ---------- id=1：播放前瞬时复位（并行） ----------
    //   范围选择 + index：等价于原来的 9 个逐球 Transform，公式与成员 .position(...) 同源
    //   （duration=0 时 translation 是绝对位姿，故必须与声明位置保持一致）
    Transform(1){
        objects: ["SawtoothSphere[0..4]"],
        translation: [-0.5 + 0.4/pi * ((index >= 1 ? 1 : 0) + (index >= 2 ? -1/2 : 0) + (index >= 3 ? 1/3 : 0) + (index >= 4 ? -1/4 : 0)), 1.5, 0.0],
        duration: 0
    }
    Transform(1){
        objects: ["SawtoothCircle[0..3]"],
        translation: [-0.5 + 0.4/pi * ((index >= 1 ? 1 : 0) + (index >= 2 ? -1/2 : 0) + (index >= 3 ? 1/3 : 0) + (index >= 4 ? -1/4 : 0)), 1.5, 0.0],
        duration: 0
    }

    // ---------- id=2：动画（并行） ----------
    Orbit(2){
        objects: ["SawtoothSphere1, SawtoothCircle1"],
        center: "SawtoothSphere0",
        angle: 90,
        alignPath: false,
        clockwise: true,
        revolutions: 1,
        duration: 12
    }
    Orbit(2){
        objects: ["SawtoothSphere2, SawtoothCircle2"],
        center: "SawtoothSphere1",
        angle: 90,
        alignPath: false,
        clockwise: false,
        revolutions: 2,
        duration: 12
    }
    Orbit(2){
        objects: ["SawtoothSphere3, SawtoothCircle3"],
        center: "SawtoothSphere2",
        angle: 90,
        alignPath: false,
        clockwise: true,
        revolutions: 3,
        duration: 12
    }
    Orbit(2){
        objects: ["SawtoothSphere4"],
        center: "SawtoothSphere3",
        angle: 90,
        alignPath: false,
        clockwise: false,
        revolutions: 4,
        duration: 12
    }
    MoveAlong(2){
        objects: ["SawtoothSphereSine"],
        path: "SawtoothSineY",
        tStart: 2*pi,
        tEnd: 0.0,
        alignPath: false,
        clockwise: false,
        iterations: 1,
        duration: 12.0
    }
    EntityMesh(2){
        objects: "SawtoothSineXY",
        y: "(40/pi)*(sin(t+phase)-sin(2*(t+phase))/2+sin(3*(t+phase))/3-sin(4*(t+phase))/4)",
        phase: "[2*pi, 0]",
        duration: 12.0
    }
    Show(3){
        objects: ["SawtoothTextRun"]
        motionType: .pop
        duration: 0.5
    }
}

Behavior()
.name("tap_SawtoothTextBack")
.trigger{
    Tap(){
        objects: ["SawtoothTextBack"]
    }
}
.actions{
    Emphasize(1){
        objects: ["SawtoothTextBack"]
        motionType: .pop
        duration: 0.4
    }
    Speak(2){
        object: "SawtoothTextBack"
        text: "返回傅立叶级数。"
    }
    OpenScene(3){
        scene: "1 傅立叶级数.md"
        duration: 0
    }
}