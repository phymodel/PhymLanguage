// MicroDuck · 3D 打印件 ①：滑轮（TPU）
//
// 实测来源：vla-trainer/vla-hardware/3D-printed-parts/3D打印缝合怪版/stl模型/TPU部分/滑轮.stl
//   · 外径 Ø30.0 mm、总厚 7.60 mm
//   · 轴孔 Ø8.8 mm（实测内缘 r = 4.40）
//   · 轮缘绳槽：真件是 V 槽（外缘 r 12→15 之间被削掉 z 0.49…7.11 那一段），
//     这里用一圈 R3 的环槽近似 —— 槽型（V 角 / 底径）还需要对着实物确认，见讲义。
//
// phym 的长度单位是**米**，所以下面每个数字都是「实测毫米 ÷ 1000」。
// 想按毫米读：0.015 = 15 mm、0.0076 = 7.6 mm。
//
// 导出（给 vla-trainer 打印用）：⚙︎ 设置 → 导出实体 → 目标＝Pulley → 单位＝毫米
//   → Export Binary STL 或 Export 3MF。导出后 Z 朝上、尺寸 30.00 × 30.00 × 7.60 mm。

CAD()
.name("Pulley")
.mesh(commands: [
    // 轮体：Ø30 圆盘，挤 7.6 厚（轮廓在 XY 平面，沿法线 Z 拉伸）
    "DEF body = PATH_FORMULA 0,0,0 Z (x)^2+(y)^2=0.015^2 0.02 EXT 0.0076",
    // 轴孔：Ø8.8（比轮体高，保证布尔能切穿）
    "DEF bore = PATH_FORMULA 0,0,0 Z (x)^2+(y)^2=0.0044^2 0.01 EXT 0.02",
    "DEF withBore = SUBTRACT body bore",
    // 绳槽：在 r = 15 mm 处绕一圈 R3 的环（近似 V 槽）
    "DEF groove = SOLID_FORMULA 0,0,0 ((x^2+y^2)^0.5-0.015)^2+z^2-0.003^2=0 0.02 40",
    "DEF pulley = SUBTRACT withBore groove",
])
.material(red: 0.35, green: 0.85, blue: 0.55, opacity: 1, roughness: 0.9, metallic: 0.0)
.physic(mass: 0.02, staticFriction: 0.8, dynamicFriction: 0.6, restitution: 0.1, mode: .kinematic)
.position(x: 0.0, y: 1.5, z: 0.0)
