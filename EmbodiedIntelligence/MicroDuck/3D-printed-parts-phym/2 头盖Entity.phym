// MicroDuck · 3D 打印件 ②：头盖（躯体部分，PLA）
//
// 形状 = **拱形顶棚（arched canopy）**：x–z 断面是一道拱（两侧壁陡直落到 z=0），沿长度方向铺开、
// 越往前越窄越矮；底面全开，只有两条脚线落在 z=0 上；两侧长边各有一个大拱形开口，
// 顶脊一排 5 条通风槽，两侧壁各 3 条水平通槽。
//
// ⚠️ 第一版（LOFT 同心椭圆 + SHELL）做成的是**封闭鼓形壳** —— 那是拓扑错误，不是尺寸误差。
//    这一版按原件的真实拓扑重做：外拱放样 → 切地平面 → 剪后颈 → 减去内腔 → 开侧窗 → 开通槽。
//
// ── 实测来源 ───────────────────────────────────────────────────────────────
// vla-trainer/vla-hardware/3D-printed-parts/3D打印缝合怪版/stl模型/躯体部分/头盖.stl
//   外形      91.76 × 122.69 × 46.34 mm（x × y × z），体积 29 139 mm³
//   壁厚      侧壁 1.7 mm、顶板 1.2 mm（沿 x 的横切宽度实测 1.67…1.75 mm；
//             沿 z 的顶板厚度实测 1.17 mm —— 所以内腔不是等距偏移，见下面 cavityArch 的说明）
//   断面      每 1 mm 取一次 x–z 断面，取半宽 W（z≈0 处最宽）与脊高 H（x=0 处最高）：
//               y = -66  H 45.2  W 54*      y = -60  H 46.1  W 45.1
//               y = -40  H 44.6  W 44.5     y = -20  H 43.0  W 43.0
//               y =   0  H 41.5  W 40.0     y =  20  H 38.9  W 38.7
//               y =  40  H 32.8  W 33.8     y =  50  H 23.6  W 25.6
//               y =  56  H  6.0  W  8.6
//             （41 个截面全部写在下面两条 LOFT 里；* y<-62 的 W 是「把椭圆反解到脚宽」的值，
//               那一段马上被 backTrim 剪掉，只留顶脊那一条带）
//
// ── 坐标系（导出后与原件逐轴一致）───────────────────────────────────────────
//   X = 左右（宽 91.8）   Y = 上（高 46.3）   Z = −原件的 y（所以「前」= −Z，「后颈」= +Z）
//   导出时自动转成 Z 朝上（绕 X 轴 +90°；STL / 3MF 都是格式固定、面板里没有勾选框）后，
//   STL 的 x / y / z 与原件 stl模型 完全对齐，可直接替换。
//
// ── 27 条命令 = 2 段放样 + 12 条布尔 ──────────────────────────────────────
//   ① outerArch     外拱：41 个截面沿 Z 放样（椭圆半宽 W、半高 H，正是实测的拱形断面）
//   ② cavityArch    内腔：同样的 41 个截面，半宽 −1.7、半高 −1.2，前后各内收 1.2 mm
//   ③ zFloor        地平面（切掉椭圆的下半截：拱只到 z=0，不是完整的橄榄形）
//   ④ arch          = outerArch − zFloor
//   ⑤ backTrim      后颈：y<-60 那一段的脚线往上卷（实测脚线 z 从 0 抬到 43 mm），
//                    剪掉「按椭圆铺到底」会多出来的裙边
//   ⑥ archTrimmed   = arch − backTrim
//   ⑦ backTrimInner 同一个后颈，高度 +2 mm（留出后颈那条 2 mm 的翻边）
//   ⑧ cavityTrimmed = cavityArch − backTrimInner
//   ⑨ shell         = archTrimmed − cavityTrimmed   ← 得到 1.7/1.2 mm 壁厚的敞口拱形壳
//   ⑩ sideWindow    两侧长边的大拱形开口（30 个实测点组成的 y–z 轮廓，沿 X 打穿两壁）
//   ⑪ part1         = shell − sideWindow
//   ⑫–⑰ slot1..3        两侧壁各 3 条水平通槽（y −41…−31，z 10.25/15.25/20.25 起各 3.5 mm 高）
//   ⑱–㉗ vent1..5        顶脊一排 5 条通风槽（x 0、±9.1、±17.85，y −41…−53.6）
//
// ── 已知偏差（不是失误，是当前命令集的天花板）─────────────────────────────
//   1. **肩部略扁**：LOFT 的截面只能是椭圆，而原件的断面是「超椭圆」（实测指数 p≈2.8）：
//      脊高与脚宽都逐点对齐（偏差 < 0.1 mm），但 z 在半高处模型比原件窄、最多差 ~5 mm。
//      正解是给 LOFT 加「自由截面 / 超椭圆指数」，见 Entity_CAD/LOFT.md 的待办。
//   2. **省掉的细节**：后段 y≈−48/−50.5 处的两条内部加强肋、前脸中央的螺柱凸台、
//      底缘的定位小台阶 —— 都是局部特征，不影响拓扑与装配尺寸。
//   3. 布尔结果是 CSG 网格，含 T 形接点（3 700 多条「边界边」里绝大多数是它）。
//      切片不受影响：z=5 / 12 / 20 / 35、y=10、x=30 六个断面的轮廓端点度数全为 2
//      （y=−20 正好落在一个放样截面上，出现 4 个擦边端点）。原件是严格水密的（边界边 0）；
//      若要「每条棱恰好两个面」，需要给布尔加一步顶点焊接。
//
// 导出：⚙︎ 设置 → 导出实体 → 目标＝HeadCover → 单位＝毫米（轴向自动 Z 朝上，不用勾）→ STL / 3MF。

CAD()
.name("HeadCover")
.mesh(commands: [
    // ① 外拱：41 个实测截面沿 Z（+Z = 原件 −y = 往后颈）放样。
    //    记号 h=ax,ay:cx,cy —— ax 半宽（左右）、ay 半高、cy 把椭圆中心抬到 +2 mm：
    //    这样椭圆最宽那一圈落在 Y=+2 mm 而不是 Y=0，避开「切割面正好切在最宽处」的相切退化
    //    （相切时布尔会切出开口边）。脚宽因此只差 0.05 mm，脊高逐点不变。
    "DEF outerArch = LOFT 0,0,-0.0565 Z 0=0.005,0.0021:0,0.0009 0.001=0.01174,0.00729:0,0.002 0.0025=0.01757,0.01307:0,0.002 0.0045=0.02231,0.01805:0,0.002 0.0065=0.02558,0.02155:0,0.002 0.0085=0.02802,0.02422:0,0.002 0.0105=0.02996,0.02639:0,0.002 0.0125=0.03154,0.02818:0,0.002 0.0165=0.03395,0.03092:0,0.002 0.0205=0.03566,0.03294:0,0.002 0.0245=0.03696,0.03445:0,0.002 0.0285=0.03796,0.03561:0,0.002 0.0325=0.03877,0.03651:0,0.002 0.0365=0.03943,0.03724:0,0.002 0.0405=0.03995,0.03787:0,0.002 0.0445=0.04046,0.03835:0,0.002 0.0485=0.04116,0.03877:0,0.002 0.0525=0.042,0.0392:0,0.002 0.0565=0.04251,0.03962:0,0.002 0.0605=0.04272,0.03994:0,0.002 0.0645=0.04259,0.04025:0,0.002 0.0685=0.04252,0.04056:0,0.002 0.0725=0.04292,0.04086:0,0.002 0.0765=0.04321,0.04117:0,0.002 0.0805=0.0435,0.04148:0,0.002 0.0845=0.04379,0.04178:0,0.002 0.0885=0.04408,0.04208:0,0.002 0.0925=0.04436,0.04236:0,0.002 0.0965=0.04464,0.04264:0,0.002 0.1005=0.04492,0.04288:0,0.002 0.1045=0.0452,0.04316:0,0.002 0.1085=0.04548,0.04344:0,0.002 0.1125=0.04577,0.04377:0,0.002 0.1145=0.04586,0.04391:0,0.002 0.1165=0.04514,0.04405:0,0.002 0.1175=0.04492,0.04412:0,0.002 0.1185=0.04499,0.04419:0,0.002 0.1195=0.04606,0.04426:0,0.002 0.1205=0.04741,0.04433:0,0.002 0.1215=0.05058,0.04416:0,0.002 0.1225=0.05399,0.04319:0,0.002 SEG 48 SUB 1",
    // ② 内腔：同样的截面，半宽 −1.7 mm、半高 −1.2 mm，前后各内收 1.2 mm → 端壁 1.2 mm
    "DEF cavityArch = LOFT 0,0,-0.0565 Z 0.0012=0.01099,0.00699:0,0.002 0.0025=0.01587,0.01187:0,0.002 0.0045=0.02061,0.01685:0,0.002 0.0065=0.02388,0.02035:0,0.002 0.0085=0.02632,0.02302:0,0.002 0.0105=0.02826,0.02519:0,0.002 0.0125=0.02984,0.02698:0,0.002 0.0165=0.03225,0.02972:0,0.002 0.0205=0.03396,0.03174:0,0.002 0.0245=0.03526,0.03325:0,0.002 0.0285=0.03626,0.03441:0,0.002 0.0325=0.03707,0.03531:0,0.002 0.0365=0.03773,0.03604:0,0.002 0.0405=0.03825,0.03667:0,0.002 0.0445=0.03876,0.03715:0,0.002 0.0485=0.03946,0.03757:0,0.002 0.0525=0.0403,0.038:0,0.002 0.0565=0.04081,0.03842:0,0.002 0.0605=0.04102,0.03874:0,0.002 0.0645=0.04089,0.03905:0,0.002 0.0685=0.04082,0.03936:0,0.002 0.0725=0.04122,0.03966:0,0.002 0.0765=0.04151,0.03997:0,0.002 0.0805=0.0418,0.04028:0,0.002 0.0845=0.04209,0.04058:0,0.002 0.0885=0.04238,0.04088:0,0.002 0.0925=0.04266,0.04116:0,0.002 0.0965=0.04294,0.04144:0,0.002 0.1005=0.04322,0.04168:0,0.002 0.1045=0.0435,0.04196:0,0.002 0.1085=0.04378,0.04224:0,0.002 0.1125=0.04407,0.04257:0,0.002 0.1145=0.04416,0.04271:0,0.002 0.1165=0.04344,0.04285:0,0.002 0.1175=0.04322,0.04292:0,0.002 0.1185=0.04329,0.04299:0,0.002 0.1195=0.04436,0.04306:0,0.002 0.1205=0.04571,0.04313:0,0.002 0.1213=0.04811,0.04302:0,0.002 SEG 48 SUB 1",
    // ③ 地平面：覆盖整件的大方盒（x ±60、z −70…70、y −60…0），切掉椭圆的下半截
    "DEF zFloor = PATH 0,0,-0.07 Z -0.06,-0.06 0.06,-0.06 0.06,0 -0.06,0 EXT 0.14",
    // ④ 外拱 = 放样 − 下半截（拱只到 z=0，不是完整的橄榄形）
    "DEF arch = SUBTRACT outerArch zFloor",
    // ⑤ 后颈修剪：y −60…−66 那段的脚线往上卷（实测脚线 z：0→5.6→13.0→20.5→27.9→35.4→42.8 mm）
    //    轮廓点是 (高度, −原件y)，沿 X 拉伸 → 把「按椭圆铺到底」多出来的裙边剪掉
    "DEF backTrim = PATH -0.055,0,0 X -0.02,0.0595 -0.02,0.071 0.044,0.071 0.0428,0.066 0.0354,0.065 0.0279,0.064 0.0205,0.063 0.013,0.062 0.0056,0.061 0,0.06 0,0.0595 EXT 0.11",
    // ⑥
    "DEF archTrimmed = SUBTRACT arch backTrim",
    // ⑦ 同一副后颈轮廓，高度 +2 mm —— 后颈留一条约 2 mm 的翻边
    "DEF backTrimInner = PATH -0.055,0,0 X -0.018,0.0595 -0.018,0.071 0.046,0.071 0.0448,0.066 0.0374,0.065 0.0299,0.064 0.0225,0.063 0.015,0.062 0.0076,0.061 0.002,0.06 0.002,0.0595 EXT 0.11",
    // ⑧
    "DEF cavityTrimmed = SUBTRACT cavityArch backTrimInner",
    // ⑨ 壳 = 外拱 − 内腔：侧壁 1.7 mm、顶板 1.2 mm，底面全开
    "DEF shell = SUBTRACT archTrimmed cavityTrimmed",
    // ⑩ 侧窗：两侧长边的大拱形开口。轮廓 30 个点逐点实测（原件 y −14.9…+10.9、顶点 z 17.2），
    //    点是 (高度, −原件y)，沿 X 拉伸 110 mm 打穿两壁
    "DEF sideWindow = PATH -0.055,0,0 X -0.003,-0.0149 0,0.0149 0.0021,0.0119 0.0041,0.0112 0.0062,0.0103 0.0082,0.0099 0.0103,0.009 0.0118,0.0083 0.0128,0.0078 0.0138,0.0068 0.0144,0.0063 0.0154,0.0053 0.0159,0.0043 0.0164,0.0032 0.0169,0.0012 0.0172,0.0002 0.0169,-0.0008 0.0164,-0.0028 0.0159,-0.0043 0.0154,-0.0048 0.0144,-0.0063 0.0138,-0.0069 0.0128,-0.0079 0.0118,-0.0084 0.0103,-0.0089 0.0082,-0.0094 0.0062,-0.0094 0.0041,-0.0094 0.0021,-0.0104 0,-0.0109 -0.003,0.0109 EXT 0.11",
    // ⑪
    "DEF part1 = SUBTRACT shell sideWindow",
    // ⑫ 水平通槽 1/3：z 10.25…13.75，y −41…−31（沿 X 打穿两壁）
    "DEF slot1 = PATH 0,0,0.031 Z -0.05,0.01025 0.05,0.01025 0.05,0.01375 -0.05,0.01375 EXT 0.010",
    // ⑬
    "DEF part2 = SUBTRACT part1 slot1",
    // ⑭ 通槽 2/3：z 15.25…18.75
    "DEF slot2 = PATH 0,0,0.031 Z -0.05,0.01525 0.05,0.01525 0.05,0.01875 -0.05,0.01875 EXT 0.010",
    // ⑮
    "DEF part3 = SUBTRACT part2 slot2",
    // ⑯ 通槽 3/3：z 20.25…23.75
    "DEF slot3 = PATH 0,0,0.031 Z -0.05,0.02025 0.05,0.02025 0.05,0.02375 -0.05,0.02375 EXT 0.010",
    // ⑰
    "DEF part4 = SUBTRACT part3 slot3",
    // ⑱ 通风槽 1/5：x ±1.7（中心那条最宽 3.4 mm），y −41…−53.6，从 z 20 切到 52
    "DEF vent1 = PATH 0,0,0.0410 Z -0.0017,0.02 0.0017,0.02 0.0017,0.052 -0.0017,0.052 EXT 0.0126",
    // ⑲
    "DEF part5 = SUBTRACT part4 vent1",
    // ⑳ 通风槽 2/5：x 7.7…10.5
    "DEF vent2 = PATH 0,0,0.0410 Z 0.0077,0.02 0.0105,0.02 0.0105,0.052 0.0077,0.052 EXT 0.0126",
    // ㉑
    "DEF part6 = SUBTRACT part5 vent2",
    // ㉒ 通风槽 3/5：x −10.5…−7.7
    "DEF vent3 = PATH 0,0,0.0410 Z -0.0105,0.02 -0.0077,0.02 -0.0077,0.052 -0.0105,0.052 EXT 0.0126",
    // ㉓
    "DEF part7 = SUBTRACT part6 vent3",
    // ㉔ 通风槽 4/5：x 16.45…19.25
    "DEF vent4 = PATH 0,0,0.0410 Z 0.01645,0.02 0.01925,0.02 0.01925,0.052 0.01645,0.052 EXT 0.0126",
    // ㉕
    "DEF part8 = SUBTRACT part7 vent4",
    // ㉖ 通风槽 5/5：x −19.25…−16.45
    "DEF vent5 = PATH 0,0,0.0410 Z -0.01925,0.02 -0.01645,0.02 -0.01645,0.052 -0.01925,0.052 EXT 0.0126",
    // ㉗
    "DEF headCover = SUBTRACT part8 vent5",
])
.material(red: 0.85, green: 0.85, blue: 0.87, opacity: 1, roughness: 0.75, metallic: 0.05)
.physic(mass: 0.08, staticFriction: 0.6, dynamicFriction: 0.4, restitution: 0.15, mode: .kinematic)
.position(x: 0.12, y: 1.6, z: 0.0)
